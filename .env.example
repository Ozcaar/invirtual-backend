# Local services only. Copy to .env; do not use these values outside development.
POSTGRES_DB=name
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_PORT=5432
API_PORT=8080
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=change-me-local-only

# API configuration when running Spring Boot on the host.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/name
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=user
SUPABASE_ISSUER_URI=https://x.supabase.co/auth/v1
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-random-local-value-at-least-32-bytes-long
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/success
STRIPE_CANCEL_URL=http://localhost:3000/cancel
STRIPE_ENVIRONMENT=TEST
STRIPE_DEFAULT_CURRENCY=MXN
